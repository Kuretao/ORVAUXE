  },
  "devDependencies": {
    "@orvauxe/eslint-config": "workspace:*",
    "@orvauxe/typescript-config": "workspace:*",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
